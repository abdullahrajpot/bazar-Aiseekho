# Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

PORT=3000
DISPATCH_DRIVER_PHONE=

# Twitter/X (optional; often requires paid credits)
# TWITTER_BEARER_TOKEN=

# Reddit User-Agent (recommended for free Reddit JSON)
# REDDIT_USER_AGENT=BazarCrisisIntel/1.0 (yourname; contact@email.com)

OPENWEATHER_API_KEY=

# OpenRouteService (FREE) — preferred for truck routes when set
# https://openrouteservice.org/dev/#/signup → Dashboard → copy "API key"
OPENROUTESERVICE_API_KEY=

# HERE Maps (optional if OpenRouteService is set)
HERE_API_KEY=

whatsapp=
WHATSAPP_PHONE_ID=

EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
BACKEND_URL=http://localhost:3000
